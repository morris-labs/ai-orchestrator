# Pinned versions for the Agent Box image (image/Dockerfile).
#
# scripts/build-image.sh passes every KEY=VALUE line as a --build-arg.
# scripts/bump-versions.sh refreshes the CLI and nvm pins from npm and
# GitHub. scripts/set-version.sh sets AGENTBOX_ENGINE_VERSION together with
# every package.json, and CI fails when they disagree.
#
# Keep the format plain: one KEY=VALUE per line, no quotes, no spaces.
# Recorded 2026-10-28.
AGENTBOX_ENGINE_VERSION=4.0.0-dev
CLAUDE_CODE_VERSION=2.1.312
CODEX_VERSION=0.165.0
COPILOT_VERSION=1.0.105
NVM_VERSION=v0.40.8
