# Pinned versions for the AI Orchestrator image (image/Dockerfile).
#
# scripts/build-image.sh passes every KEY=VALUE line as a --build-arg.
# scripts/bump-versions.sh refreshes the CLI and nvm pins from npm and
# GitHub. scripts/set-version.sh sets AIO_ENGINE_VERSION together with
# every package.json, and CI fails when they disagree.
#
# Keep the format plain: one KEY=VALUE per line, no quotes, no spaces.
# Recorded 2026-11-13.
AIO_ENGINE_VERSION=1.0.0
CLAUDE_CODE_VERSION=2.1.323
CODEX_VERSION=0.169.0
COPILOT_VERSION=1.0.111
NVM_VERSION=v0.40.8
