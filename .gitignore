# Build output
/gui/

# Release packages (AppImage, .deb, Windows installer) -- built artifacts, not source.
/dist/
/installer/

# IDE/editor state -- local to each developer's machine.
/.vscode/

# Git credential store and env files -- hold live PATs/secrets, must never be committed.
.git-credentials
.env
*.env

# Per-platform release workspaces -- local working directories, not source.
/Windows_Release/
/Mac_Release/

# Legacy bash launcher/manager -- kept on disk as a working fallback while
# Agent Box 4 replaced them, but not tracked here.
/claude-box.bash
/claude-box-manager.bash
/claude-box-lib.bash
/claude-box-resume-all.bash
/claude-box-resume.service
/docker-compose.yml
/gitcontrol.sh

# Node workspace (Agent Box 4.0.0)
node_modules/
dist/
*.tsbuildinfo
coverage/
test-results/
.pnpm-store/

# Developer notes and plans -- kept locally, not published.
docs/v4/
STATUS.md
PLAN.md
INFRA.md
plan-*.md
CLAUDE.md
*.log
