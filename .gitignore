# Build output
/gui/

# Release packages (AppImage, .deb, Windows installer) -- built artifacts, not source.
/dist/
/installer/

# IDE/editor state -- local to each developer's machine.
/.vscode/

# Git credential store and env files -- hold live PATs/secrets, must never be committed.
.git-credentials
.env
*.env

# Per-platform release workspaces -- local working directories, not source.
/Windows_Release/
/Mac_Release/

# Node workspace (AI Orchestrator 1.0.0)
node_modules/
dist/
*.tsbuildinfo
coverage/
test-results/
.pnpm-store/

# Developer notes and plans -- kept locally, not published.
docs/v4/
STATUS.md
PLAN.md
INFRA.md
plan-*.md
CLAUDE.md
*.log
