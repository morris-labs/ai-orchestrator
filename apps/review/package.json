{
  "name": "@agentbox/review",
  "productName": "Agent Box Review",
  "version": "4.0.0",
  "desktopName": "agentbox-review.desktop",
  "description": "The agentbox-review app: review runs, findings, policy, and the infrastructure dashboard.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json --noEmit && vite build && vite build -c vite.electron.config.ts --mode main && vite build -c vite.electron.config.ts --mode preload",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "electron": "electron .",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:setup": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@agentbox/contracts": "workspace:*",
    "@agentbox/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "26.17.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
