{
  "name": "@agentbox/boxes",
  "productName": "Agent Box",
  "version": "4.0.0-dev",
  "description": "The agentbox app: manage boxes, conversations, and their terminals.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.electron.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "electron": "electron .",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@agentbox/contracts": "workspace:*",
    "@agentbox/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
