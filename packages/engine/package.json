{
  "name": "@agentbox/engine",
  "version": "4.0.0-dev",
  "description": "The Agent Box engine: the review pipeline service inside each project container.",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "agentbox-engine": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbox/contracts": "workspace:*",
    "fastify": "^5.6.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
