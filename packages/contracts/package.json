{
  "name": "@aio/contracts",
  "version": "3.3.0",
  "description": "Zod schemas and TypeScript types shared by every AI Orchestrator package.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tls": {
      "types": "./dist/tls.d.ts",
      "import": "./dist/tls.js"
    },
    "./gui-enroll": {
      "types": "./dist/gui-enroll.d.ts",
      "import": "./dist/gui-enroll.js"
    },
    "./gui-client": {
      "types": "./dist/gui-client.d.ts",
      "import": "./dist/gui-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
