{
  "name": "@agentbox/cli",
  "version": "4.0.0",
  "description": "The agentbox command-line client for the Agent Box server.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentbox": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbox/contracts": "workspace:*",
    "commander": "^14.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
