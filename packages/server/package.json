{
  "name": "@agentbox/server",
  "version": "4.0.0-dev",
  "description": "The Agent Box host server: Docker, boxes, projects, worktrees, catalog, and services.",
  "private": true,
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbox/contracts": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "dockerode": "^4.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
