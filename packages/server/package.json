{
  "name": "@aio/server",
  "version": "3.3.1",
  "description": "The AI Orchestrator host server: Docker, boxes, projects, worktrees, the REST and WebSocket API, terminals, proxy, scheduler, and services.",
  "private": true,
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "bin": {
    "aio-server": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aio/contracts": "workspace:*",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.1",
    "dockerode": "^4.0.9",
    "fastify": "^5.6.1",
    "smol-toml": "^1.9.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
