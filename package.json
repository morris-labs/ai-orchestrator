{
  "name": "aio-workspace",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "test": "corepack pnpm -r --if-present build && corepack pnpm -r --if-present test",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r --if-present build && corepack pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
