[Desktop Entry]
Type=Application
Version=1.5
Name=AI Orchestrator Review
GenericName=Code Review Pipeline
Comment=Run multi-vendor code reviews on a box's branch and watch them live
Exec=/usr/bin/aio-review %U
Icon=aio-review
Terminal=false
Categories=Development;
Keywords=review;claude;codex;copilot;agent;pipeline;findings;
# The app keeps one instance and hands a second launch to the first, so the
# shell has no new window to wait for. StartupNotify stays off to avoid a
# busy cursor that never clears.
StartupNotify=false
# Must match the Electron app's WM_CLASS and its desktopName, so GNOME on
# Wayland ties the window to this entry and shows the right icon.
StartupWMClass=aio-review
