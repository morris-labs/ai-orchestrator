#!/bin/sh
# postinst for the aio package.
set -e

case "$1" in
  configure)
    # Load the AppArmor profiles that let the Electron apps use their
    # sandbox on Ubuntu 24.04 and later. A host without AppArmor skips this.
    # Without a loaded profile, Chromium falls back to its setuid sandbox
    # helper, which must be owned by root with mode 4755. An app whose
    # profile loaded uses user namespaces instead, so its helper doesn't
    # get the setuid bit, unless the kernel turns user namespaces off for
    # unprivileged users, where only the helper works.
    have_apparmor=0
    if command -v apparmor_parser > /dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
      have_apparmor=1
    fi
    userns_off=0
    if [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2> /dev/null || echo 1)" = 0 ] ||
      [ "$(cat /proc/sys/user/max_user_namespaces 2> /dev/null || echo 1)" = 0 ]; then
      userns_off=1
    fi
    for app in boxes review; do
      loaded=0
      if [ "$have_apparmor" = 1 ] && apparmor_parser -r -T -W "/etc/apparmor.d/aio-$app"; then
        loaded=1
      fi
      helper="/usr/lib/ai-orchestrator/$app/chrome-sandbox"
      if [ -f "$helper" ]; then
        chown root:root "$helper"
        if [ "$loaded" = 1 ] && [ "$userns_off" = 0 ]; then
          chmod 0755 "$helper"
        else
          chmod 4755 "$helper"
        fi
      fi
    done

    if command -v update-desktop-database > /dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache > /dev/null 2>&1; then
      gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi

    # dpkg passes the previously configured version as $2 on an upgrade.
    # The running server keeps the old code, and the files under it have
    # changed, so it must be restarted. Root can't reach each user's
    # systemd user manager, so the package asks instead.
    if [ -n "${2:-}" ]; then
      cat <<'MSG'

AI Orchestrator is upgraded. A server that was already running still runs the
old version. As each user who runs the server, restart it:

  systemctl --user daemon-reload && systemctl --user restart aio-server

Then rebuild the container image from the setup wizard, or with
/usr/share/ai-orchestrator/scripts/build-image.sh, so that its engine matches the
new server.

MSG
      exit 0
    fi

    cat <<'MSG'

AI Orchestrator is installed. The server runs as your user, not as root, under
your systemd user manager. As the user who runs your boxes, enable and
start it:

  systemctl --user enable --now aio-server

To keep it running while you're logged out, also run:

  sudo loginctl enable-linger "$USER"

Your user must be in the docker group. Then open AI Orchestrator from your
applications menu; its setup wizard builds the container image from
/usr/share/ai-orchestrator/image. For more information, see
https://github.com/morris-labs/ai-orchestrator/blob/main/docs/install.md

To join this machine to a hub, choose Node in the setup wizard, or run
aio node join. A hub accepts node links on TCP port 21402 on its LAN
address. The package installs the ufw application profile aio-hub for that
port but opens nothing. On a hub that runs ufw, allow your LAN, where
LAN_CIDR is its range, such as 192.0.2.0/24:

  sudo ufw allow from LAN_CIDR to any app aio-hub

For more information, see
https://github.com/morris-labs/ai-orchestrator/blob/main/docs/multi-host.md

MSG
    ;;
esac

exit 0
